#
# Recommended minimum configuration:
#

# -- 1. NETWORK AND ACCESS CONFIGURATION --

# Explicit HTTP proxy port (for manual proxy settings).
#
# 'ssl-bump' is REQUIRED here, not optional. The generated deny rules are scoped
# to '!CONNECT' so that intercepted HTTPS can be bumped and shown the block page
# (see rules.acl). That scoping means a CONNECT is allowed through to the ssl_bump
# stage — so any port handling CONNECT must be able to bump, or a client manually
# configured to use this port would tunnel straight past the blocklists.
http_port 3128 ssl-bump generate-host-certificates=on dynamic_cert_mem_cache_size=16MB cert=/etc/squid/certs/squid-ca.pem key=/etc/squid/certs/squid-ca.key

# Transparent HTTP proxy port (for router port 80 redirection)
http_port 3129 intercept

# Disable strict host verification to allow transparent interception with remote router DNAT
host_verify_strict off

# Custom error pages directory (Parental Control Block Page)
error_directory /etc/squid/configs/errors

# Transparent HTTPS interception port using ssl-bump.
# Container-level iptables REDIRECT from port 443 to 3130 preserves SO_ORIGINAL_DST.
https_port 3130 intercept ssl-bump generate-host-certificates=on dynamic_cert_mem_cache_size=16MB cert=/etc/squid/certs/squid-ca.pem key=/etc/squid/certs/squid-ca.key

# Define an Access Control List (ACL) for your local network.
# Adjust this to match your home network's IP range.
acl localnet src 192.168.0.0/16

# Define standard ports for SSL/TLS and other safe protocols.
acl SSL_ports port 443 3130 4070
acl Safe_ports port 80          # http
acl Safe_ports port 21          # ftp
acl Safe_ports port 443         # https
acl Safe_ports port 3130        # transparent ssl-bump
acl Safe_ports port 4070        # spotify ap
acl Safe_ports port 70          # gopher
acl Safe_ports port 210         # wais
acl Safe_ports port 1025-65535  # unregistered ports
acl Safe_ports port 280         # http-mgmt
acl Safe_ports port 488         # gss-http
acl Safe_ports port 591         # filemaker
acl Safe_ports port 777         # multiling http
acl CONNECT method CONNECT

# -- 2. HTTP ACCESS RULES --
#
# ORDER MATTERS. Squid stops at the first matching http_access line, so the port
# safety guards must come BEFORE the Web UI rules: an 'http_access allow' emitted
# for a device time-window would otherwise short-circuit both denies below and
# permit CONNECT to arbitrary ports.

# 1. Allow localhost and internal helper requests (AIA cert downloads)
http_access allow localhost

# 2. Deny requests to non-safe ports.
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports

# 3. Dynamic Conditional Access Rules (Managed by Web UI)
include /etc/squid/configs/rules.acl

# 4. Allow access from your local network.
http_access allow localnet

# 5. Deny all other access to this proxy.
http_access deny all

# Prevent proxy loop by forcing DNS resolution of Host header/SNI when destination IP is local proxy IP
acl proxy_self dst 192.168.0.0/16
always_direct deny proxy_self


# -- 4. SSL BUMPING (INTERCEPTION) RULES --

# This helper is used to generate certificates for SSL Bumping.
# Ensure the directory '/var/lib/squid' is a persistent volume.
sslcrtd_program /usr/lib/squid/security_file_certgen -s /var/lib/squid/ssl_db/db -M 16MB

# Define the SSL Bumping workflow.
# Step 1: Peek at client TLS ClientHello to extract SNI.
acl step1 at_step SslBump1
ssl_bump peek step1

# Allow transparent SSL bumping for remote upstream certificates
sslproxy_cert_error allow all

# Step 2: Dynamic Per-Device SSL Bumping (configured via /etc/squid/configs/ssl_bump.acl)
include /etc/squid/configs/ssl_bump.acl

# Step 3: Bump the global path-rule domain list.
#
# Both the 'acl bump_domains ...' declaration and the 'ssl_bump bump' line live in
# the generated bump_domains.conf rather than here. When no blocklist defines a
# 'domain/path' rule that file is empty, so no ACL is declared at all. Declaring
# one against an empty bump_domains.acl parses cleanly but can never match, which
# hides a broken selective-bump configuration behind a passing 'squid -k parse'.
include /etc/squid/configs/bump_domains.conf

# Step 4: Splice all other domains by default (raw passthrough)
ssl_bump splice all

# -- 5. CACHE AND LOGGING --

# Define the location for Squid's cache.
# 'ufs' is the standard storage format.
# '100' is the cache size in MB. '16' and '256' are directory levels.
cache_dir ufs /var/cache/squid 100 16 256

# Leave coredumps in the first cache dir
coredump_dir /var/cache/squid

# Disable log buffering so access logs are written immediately to disk.
buffered_logs off
access_log daemon:/var/log/squid/access.log squid
# Keep 30 numbered generations when the daily scheduler sends Squid its
# rotation signal. With one rotation at midnight, this retains 30 full days of
# history in addition to the active log for the current day.
logfile_rotate 30

# Add a header to requests to show they went through the proxy.
via on
