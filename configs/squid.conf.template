#
# Recommended minimum configuration:
#

# -- 1. NETWORK AND ACCESS CONFIGURATION --

# Explicit HTTP proxy port (for manual proxy settings)
http_port 3128

# Transparent HTTP proxy port (for router port 80 redirection)
http_port 3129 intercept

# Disable strict host verification to allow transparent interception with remote router DNAT
host_verify_strict off

# Define the port for transparent HTTPS interception (SSL Bumping).
https_port 3130 intercept ssl-bump generate-host-certificates=on dynamic_cert_mem_cache_size=16MB cert=/etc/squid/certs/squid-ca.pem key=/etc/squid/certs/squid-ca.key

# Define an Access Control List (ACL) for your local network.
# Adjust this to match your home network's IP range.
acl localnet src 192.168.0.0/16

# Define standard ports for SSL/TLS and other safe protocols.
acl SSL_ports port 443 3130
acl Safe_ports port 80          # http
acl Safe_ports port 21          # ftp
acl Safe_ports port 443         # https
acl Safe_ports port 3130        # transparent ssl-bump
acl Safe_ports port 70          # gopher
acl Safe_ports port 210         # wais
acl Safe_ports port 1025-65535  # unregistered ports
acl Safe_ports port 280         # http-mgmt
acl Safe_ports port 488         # gss-http
acl Safe_ports port 591         # filemaker
acl Safe_ports port 777         # multiling http
acl CONNECT method CONNECT

# -- 2. BLOCKLIST CONFIGURATION --

# -- 3. HTTP ACCESS RULES --

# 1. Allow localhost and internal helper requests (AIA cert downloads)
http_access allow localhost

# 2. Dynamic Conditional Access Rules (Managed by Web UI)
include /etc/squid/configs/rules.acl

# 3. Block access to domains in the blocklist.


# 3. Deny requests to non-safe ports.
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports

# 4. Allow access from your local network.
http_access allow localnet

# 5. Deny all other access to this proxy.
http_access deny all

# Always connect directly to origin servers (prevents proxy loops when destination IP is DNAT'd)
always_direct allow all

# -- 4. SSL BUMPING (INTERCEPTION) RULES --

# This helper is used to generate certificates for SSL Bumping.
# Ensure the directory '/var/lib/squid' is a persistent volume.
sslcrtd_program /usr/lib/squid/security_file_certgen -s /var/lib/squid/ssl_db/db -M 16MB

# Define the SSL Bumping workflow.
# Step 1: Peek at client TLS ClientHello to extract SNI.
acl step1 at_step SslBump1
ssl_bump peek step1

# Allow transparent SSL bumping for remote upstream certificates
sslproxy_flags DONT_VERIFY_PEER
sslproxy_cert_error allow all

# Step 2: Bump (decrypt and inspect) connections.
ssl_bump bump all

# -- 5. CACHE AND LOGGING --

# Define the location for Squid's cache.
# 'ufs' is the standard storage format.
# '100' is the cache size in MB. '16' and '256' are directory levels.
cache_dir ufs /var/cache/squid 100 16 256

# Leave coredumps in the first cache dir
coredump_dir /var/cache/squid

# Disable log buffering so access logs are written immediately to disk.
buffered_logs off
access_log daemon:/var/log/squid/access.log squid

# Add a header to requests to show they went through the proxy.
via on
