# Copy this directory to deployments/local and replace the documentation-only
# RFC 5737 addresses with values for your network.

TIMEZONE=UTC

# QNAP/NAS Docker host.
QNAP_IP=192.0.2.2
QNAP_USER=admin
QNAP_DOCKER=/usr/bin/docker
QNAP_CONTAINER_ROOT=/share/Container
QNAP_CERT_DOWNLOAD_DIR=/share/Public/certs
QNAP_DOCKER_NETWORK=bridge
QNAP_DOCKER_HOME_ROOT=/tmp

# Router used for policy routing.
ROUTER_IP=192.0.2.1
ROUTER_USER=admin
ROUTER_LAN_INTERFACE=br0
ROUTER_ROUTE_TABLE=150
ROUTER_MARK=0x5000
ROUTER_FIREWALL_SCRIPT=/jffs/scripts/firewall-start

# Container addresses and ports.
SQUID_CONTAINER_NAME=squid-proxy
WEBUI_CONTAINER_NAME=squid-webui
SQUID_IMAGE=squid-ssl:latest
WEBUI_IMAGE=squid-webui:latest
SQUID_PROXY_IP=192.0.2.90
SQUID_PROXY_PORT=3128
SQUID_HTTP_PORT=3129
SQUID_HTTPS_PORT=3130
WEBUI_IP=192.0.2.91
WEBUI_PORT=3131
WEBUI_PUBLIC_URL=http://192.0.2.91:3131

# Space-separated CIDRs accepted by Squid. The comma-separated no-proxy value
# is written to Linux client environments.
LOCAL_NETWORKS="192.0.2.0/24"
NO_PROXY_NETWORKS="localhost,127.0.0.1,192.0.2.0/24,local,.local"

# Comma-separated WebUI clients that may administer without a password.
# Leave empty to require authentication for every client.
ADMIN_CLIENT_IPS=

# Default remote Ubuntu client used by debug/debug-proxy.sh.
DEFAULT_CLIENT_IP=192.0.2.20
DEFAULT_CLIENT_NAME=ubuntu-client

# Certificate identity; do not put private keys in this file.
CERT_SUBJECT="/C=US/O=Example Home/OU=Proxy/CN=squid.local"
CERT_NAME=squid.local
